# Which chat-model backend to use: "anthropic" | "vertex" | "gemini"
LLM_PROVIDER=anthropic

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Google Vertex AI (requires `gcloud auth application-default login`) ---
GCP_PROJECT_ID=
GCP_LOCATION=us-central1
VERTEX_MODEL=gemini-2.0-flash

# --- Google AI Studio (Gemini) ---
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional override for the eval harness's cheap judge model
JUDGE_MODEL=

# --- Literature source API keys (optional, raise rate limits) ---
NCBI_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=

# --- Disk cache for source API responses ---
CACHE_DIR=.cache
CACHE_TTL_SECONDS=604800

# --- LangSmith tracing (optional) ---
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=agentic-clinical-rag

DEBUG=false
